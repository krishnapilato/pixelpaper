<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        La fotocamera e' opzionale: senza di essa restano archivio, galleria e
        importazione dalle foto gia' presenti.

        tools:replace e' obbligatorio, non decorativo: camera_android_camerax
        dichiara la stessa feature con required="true" e per uses-feature il
        merger fa un OR, quindi senza questo il bundle finisce su Play come
        "fotocamera richiesta" e centinaia di dispositivi spariscono dalla
        compatibilita'.

        Le tre feature sono elencate tutte perche' il permesso CAMERA, da solo,
        fa dedurre a Play camera e camera.autofocus come richieste: dichiararle
        esplicitamente a false e' l'unico modo per annullare la deduzione.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"
        tools:replace="android:required" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Lo scanner ML Kit usa la fotocamera dei servizi Google Play, quindi non
        richiede permessi. image_picker usa il Photo Picker di sistema: nessun
        permesso di lettura serve. La registrazione audio arriva dal manifest di
        camera_android_camerax e viene rimossa: l'app non registra audio.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!--
        L'app non fa una sola richiesta di rete, e questi due permessi non li
        ha chiesti nessuno di noi: INTERNET arriva da
        com.google.android.datatransport, la telemetria che ML Kit si porta
        dietro, e ACCESS_NETWORK_STATE da androidx.media3, un lettore video che
        non usiamo. Nel manifest finito diventano comunque parte di cio' che
        Play mostra all'utente, e per un'app che promette di funzionare offline
        e di non mandare niente da nessuna parte quella riga contraddice la
        promessa.

        I modelli di ML Kit non ne soffrono: a scaricarli e' il processo dei
        servizi Google Play, con i propri permessi, non il nostro.

        Se un giorno servira' la rete davvero, va tolta questa rimozione e
        spiegato all'utente perche'.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:label="PixelPaper"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- Richiesto dal motore Flutter per ProcessText. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- url_launcher deve poter vedere browser e client di posta (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Apertura/condivisione dei PDF con altre app. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>
</manifest>
